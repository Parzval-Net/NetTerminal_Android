{
  "vendor": "grandstream",
  "name": "Grandstream",
  "platforms": [
    {
      "id": "gwn-sw",
      "label": "GWN78xx switches gestionables (GWN780x/781x/782x/783x)",
      "detect": "Device Model\\s*:\\s*GWN78",
      "note": "CLI tipo Cisco vía SSH, Telnet o consola (115200). Prompt hostname# y hostname(config)#. Puertos Ethernet unidad/0/puerto, ej. 1/0/1."

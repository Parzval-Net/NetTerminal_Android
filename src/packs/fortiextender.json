      "cat": "Sistema",
      "risk": "disruptive",
      "note": "Variantes: ftp {{imagen}} {{ip}} {{usuario}} {{clave}} y cloud.",
      "source": "https://docs.fortinet.com/document/fortiextender/7.6.1/admin-guide-standalone/618232/upgrade-os-firmware"
    },
    {
      "cmd": "execute debuginfo export tftp {{archivo}}.tgz {{ip_tftp}}",
      "desc": "Exporta un paquete comprimido con toda la información de diagnóstico (software, hardware, configuración, CPU) para TAC.",

      "risk": "change",
      "source": "https://docs.fortinet.com/document/fortiextender/7.6.1/admin-guide-standalone/769712/collect-complete-diagnostics-information"
    },
    {
      "cmd": "execute debug log-to-console on",
      "desc": "Envía los logs de debug a la sesión Telnet/SSH actual. Requisito para ver los debug por módulo.",
      "cat": "Diagnóstico",
      "risk": "change",
      "source": "https://docs.fortinet.com/document/fortiextender/7.6.1/admin-guide-standalone/415381/status-diagnostics-and-debugging-commands"
    },
    {
      "cmd": "execute debug CONNMGR info on",
      "desc": "Debug del gestor de conexión del módem (sesión LTE, SIM, APN). Usar state en vez de info para menor verbosidad.",
      "cat": "Diagnóstico",
